# Runtime database URL must use the least-privilege chatmaster_api role.
DATABASE_URL=postgresql://chatmaster_api:replace-me@localhost:5432/chatmaster

# Use at least 32 bytes of cryptographically random material. Never commit a real value.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_TOKEN_ISSUER=chatmaster-api
AUTH_TOKEN_AUDIENCE=chatmaster-web

# Exact origin allowed to make credentialed API requests.
WEB_APP_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# At-rest encryption for platform tokens: "<version>:<base64 32-byte key>[,<version>:<key>]".
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=1:replace-with-base64-32-byte-key
# ENCRYPTION_ACTIVE_KEY_VERSION=1

# Public HTTPS origin Telegram delivers webhooks to (must be HTTPS in production).
PUBLIC_API_URL=https://api.example.com
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_API_TIMEOUT_MS=5000

# Prefer connected Upstash REST credentials. The local Docker Redis URL is a fallback.
KV_REST_API_URL=https://your-upstash-instance.upstash.io
KV_REST_API_TOKEN=replace-with-upstash-token
# REDIS_URL=redis://localhost:6379

# Optional, disposable database URL using the least-privilege chatmaster_api role.
# Enables real PostgreSQL auth and RLS integration tests.
# TEST_DATABASE_URL=postgresql://chatmaster_api:replace-me@localhost:5432/chatmaster_test
